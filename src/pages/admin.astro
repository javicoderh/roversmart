---
import BaseLayout from "../layouts/BaseLayout.astro";
import "../styles/global.css";
import { getAdminCookieName, loadAdminState, readSessionUsername } from "../lib/admin-state";

let sessionUser: string | null = null;
let state = null;
let stateLoadError = "";

try {
  sessionUser = await readSessionUsername(Astro.cookies.get(getAdminCookieName())?.value);
  state = sessionUser ? await loadAdminState() : null;
} catch (error) {
  console.error("Admin page load failed:", error);
  sessionUser = null;
  state = null;
  stateLoadError = "No se pudo cargar el panel de administración. Intenta nuevamente.";
}

const errorMessage = stateLoadError || Astro.url.searchParams.get("error");
const successMessage = Astro.url.searchParams.get("success");
const currentView = Astro.url.searchParams.get("view") === "read" ? "read" : "pending";
const adminQuotes = (state?.quotes || []).map((quote: any) => ({
  ...quote,
  status: quote.status === "read" ? "read" : "pending",
  projects: quote.projects?.length
    ? quote.projects
    : [{
        id: quote.id,
        title: "Proyecto 1",
        alto: quote.project?.alto || "",
        ancho: quote.project?.ancho || "",
        ubicacion: quote.project?.ubicacion || "",
        estado: quote.project?.estado || "",
        bodegaDisponible: Boolean(quote.project?.bodegaDisponible),
        estacionamientoDisponible: Boolean(quote.project?.estacionamientoDisponible),
        descripcionMuro: quote.project?.descripcionMuro || "",
        tiposMural: quote.creative?.tiposMural || [],
        uso: quote.creative?.uso || "",
        idea: quote.creative?.idea || "",
        proteccion: quote.creative?.proteccion || [],
        fotoFrontalUrls: quote.assets?.fotoFrontalUrls || [],
        referenciasUrls: quote.assets?.referenciasUrls || []
      }]
}));
const pendingQuotes = adminQuotes.filter((quote) => quote.status !== "read");
const readQuotes = adminQuotes.filter((quote) => quote.status === "read");
const visibleQuotes = currentView === "read" ? readQuotes : pendingQuotes;
---

<BaseLayout title="Admin | Cotizador Rover Smart" description="Panel de administración de cotizaciones.">
  <main class="page-shell admin-page admin-page--minimal">
    <section class="admin-minimal-shell">
      <header class="admin-minimal-head">
        <div>
          <p class="eyebrow">Admin</p>
          <h1>Rover Smart</h1>
        </div>

        <div class="admin-icon-bar" aria-label="Acciones del panel">
          {
            sessionUser ? (
              <>
                <button class="admin-icon-button" type="button" data-modal-trigger="credentials-modal" title="Cambiar credenciales" aria-label="Cambiar credenciales">
                  <span class="admin-icon-glyph" aria-hidden="true">🔐</span>
                </button>
                <form method="POST" action="/api/admin/logout">
                  <button class="admin-icon-button" type="submit" title="Cerrar sesión" aria-label="Cerrar sesión">
                    <span class="admin-icon-glyph" aria-hidden="true">↪</span>
                  </button>
                </form>
              </>
            ) : (
              <button class="admin-icon-button" type="button" data-modal-trigger="login-modal" title="Entrar" aria-label="Entrar">
                <span class="admin-icon-glyph" aria-hidden="true">↩</span>
              </button>
            )
          }
        </div>
      </header>

      {errorMessage ? <p class="admin-flash admin-flash--error">{errorMessage}</p> : null}
      {successMessage ? <p class="admin-flash admin-flash--success">{successMessage}</p> : null}

      <section class="admin-minimal-summary">
        <article class="admin-mini-stat" data-summary-stat="pending">
          <span class="admin-mini-stat__icon" aria-hidden="true">
            <svg viewBox="0 0 24 24"><path d="M4 6.5A2.5 2.5 0 0 1 6.5 4h11A2.5 2.5 0 0 1 20 6.5v11a2.5 2.5 0 0 1-2.5 2.5h-11A2.5 2.5 0 0 1 4 17.5v-11ZM8 8h8M8 12h8M8 16h5"/></svg>
          </span>
          <strong data-summary-count>{pendingQuotes.length || 0}</strong>
        </article>

        <article class="admin-mini-stat" data-summary-stat="read">
          <span class="admin-mini-stat__icon" aria-hidden="true">
            <svg viewBox="0 0 24 24"><path d="M12 12a4 4 0 1 0 0-8 4 4 0 0 0 0 8ZM5 20a7 7 0 0 1 14 0"/></svg>
          </span>
          <strong data-summary-count>{readQuotes.length || 0}</strong>
        </article>
      </section>

      {
        sessionUser ? (
          <section class="admin-quote-strip-shell">
            <div class="admin-toolbar">
              <nav class="admin-tabs" aria-label="Filtros de cotización">
                <a class:list={["admin-tab", currentView === "pending" && "is-active"]} href="/admin" data-tab-stat="pending">
                  <span aria-hidden="true">◉</span>
                  <strong data-tab-count>{pendingQuotes.length}</strong>
                </a>
                <a class:list={["admin-tab", currentView === "read" && "is-active"]} href="/admin?view=read" data-tab-stat="read">
                  <span aria-hidden="true">◎</span>
                  <strong data-tab-count>{readQuotes.length}</strong>
                </a>
              </nav>

              {
                currentView === "read" ? (
                  <form method="POST" action="/api/admin/clear-read-quotes">
                    <button class="admin-icon-button admin-icon-button--danger" type="submit" title="Borrar contestadas" aria-label="Borrar contestadas">
                      <span class="admin-icon-glyph" aria-hidden="true">🗑</span>
                    </button>
                  </form>
                ) : null
              }
            </div>

            <section class="admin-quote-strip">
            {
              visibleQuotes.length ? (
                visibleQuotes.map((quote, index) => (
                  <div data-quote-entry data-quote-id={quote.id} data-quote-status={quote.status}>
                    <button class="admin-quote-tile" type="button" data-modal-trigger={`quote-modal-${index}`} title={`Ver ${quote.contact.name || "cotización"}`} aria-label={`Ver ${quote.contact.name || "cotización"}`}>
                      <span class="admin-quote-tile__top">
                        <span class="admin-quote-tile__avatar">{(quote.contact.name || "?").slice(0, 1).toUpperCase()}</span>
                        <span class="admin-quote-tile__icons" aria-hidden="true">
                          <svg viewBox="0 0 24 24"><path d="M4 7.5A2.5 2.5 0 0 1 6.5 5h11A2.5 2.5 0 0 1 20 7.5v9a2.5 2.5 0 0 1-2.5 2.5h-11A2.5 2.5 0 0 1 4 16.5v-9Zm0 .5 8 5 8-5"/></svg>
                          <svg viewBox="0 0 24 24"><path d="M4 6.5A2.5 2.5 0 0 1 6.5 4h11A2.5 2.5 0 0 1 20 6.5v11a2.5 2.5 0 0 1-2.5 2.5h-11A2.5 2.5 0 0 1 4 17.5v-11ZM8 8h8M8 12h8M8 16h5"/></svg>
                        </span>
                      </span>
                      <span class="admin-quote-tile__meta">
                        <strong>{quote.contact.name || "Sin nombre"}</strong>
                        <small>{quote.projects.length} proyecto{quote.projects.length === 1 ? "" : "s"}</small>
                      </span>
                    </button>

                    <dialog class="admin-modal" id={`quote-modal-${index}`}>
                      <div class="admin-modal__surface admin-modal__surface--wide">
                        <div class="admin-modal__head">
                          <div>
                            <p class="eyebrow">Cotización</p>
                            <h2>{quote.contact.name || "Sin nombre"}</h2>
                          </div>
                          <div class="admin-modal__head-actions">
                            <form method="POST" action="/api/admin/update-quote-status">
                              <input type="hidden" name="id" value={quote.id} />
                              <input type="hidden" name="status" value={quote.status === "read" ? "pending" : "read"} />
                              <input type="hidden" name="view" value={currentView} />
                              <button
                                class:list={["admin-icon-button", quote.status === "read" ? "admin-icon-button--soft" : "admin-icon-button--success"]}
                                type="submit"
                                data-quote-status-submit
                                title={quote.status === "read" ? "Marcar pendiente" : "Marcar leída"}
                                aria-label={quote.status === "read" ? "Marcar pendiente" : "Marcar leída"}
                              >
                                <span class="admin-icon-glyph" aria-hidden="true">{quote.status === "read" ? "◌" : "✓"}</span>
                              </button>
                            </form>
                            <button class="admin-icon-button admin-icon-button--soft" type="button" data-modal-close title="Cerrar" aria-label="Cerrar">
                              <span class="admin-icon-glyph" aria-hidden="true">✕</span>
                            </button>
                          </div>
                        </div>

                        <div class="admin-modal-grid">
                          <section class="admin-modal-block">
                            <span class="admin-modal-block__icon" aria-hidden="true">
                              <svg viewBox="0 0 24 24"><path d="M12 12a4 4 0 1 0 0-8 4 4 0 0 0 0 8ZM5 20a7 7 0 0 1 14 0"/></svg>
                            </span>
                            <div>
                              <strong>{quote.contact.email || "-"}</strong>
                              <p>{quote.contact.phone || "-"}</p>
                              <p>{quote.contact.clientDescription || "-"}</p>
                            </div>
                          </section>
                        </div>

                        <div class="admin-projects-list">
                          {
                            quote.projects.map((project) => (
                              <section class="admin-project-card">
                                <div class="admin-project-card__head">
                                  <strong>{project.title}</strong>
                                  <span>{project.alto}m × {project.ancho}m</span>
                                </div>
                                <div class="admin-modal-grid">
                                  <section class="admin-modal-block">
                                    <span class="admin-modal-block__icon" aria-hidden="true">
                                      <svg viewBox="0 0 24 24"><path d="M5 19V8l7-4 7 4v11M9 19v-5h6v5"/></svg>
                                    </span>
                                    <div>
                                      <strong>{project.ubicacion || "-"}</strong>
                                      <p>{project.estado || "-"}</p>
                                      <p>{project.descripcionMuro || "-"}</p>
                                    </div>
                                  </section>
                                  <section class="admin-modal-block">
                                    <span class="admin-modal-block__icon" aria-hidden="true">
                                      <svg viewBox="0 0 24 24"><path d="M5 18h14M7 14l3-3 2 2 5-5"/></svg>
                                    </span>
                                    <div>
                                      <strong>{project.tiposMural.join(", ") || "-"}</strong>
                                      <p>{project.uso || "-"}</p>
                                      <p>{project.proteccion.join(", ") || "Sin protección"}</p>
                                    </div>
                                  </section>
                                </div>
                                <section class="admin-modal-copy">
                                  <strong>Idea</strong>
                                  <p>{project.idea || "-"}</p>
                                </section>
                                <div class="admin-modal-flags">
                                  <span>{project.bodegaDisponible ? "◉ bodega" : "○ bodega"}</span>
                                  <span>{project.estacionamientoDisponible ? "◉ estacionamiento" : "○ estacionamiento"}</span>
                                </div>
                                <div class="admin-modal-assets">
                                  <div>
                                    <strong>Fotos</strong>
                                    <div class="admin-link-pack">
                                      {project.fotoFrontalUrls.map((url) => <a href={url} target="_blank" rel="noreferrer">◱</a>)}
                                    </div>
                                  </div>
                                  <div>
                                    <strong>Refs</strong>
                                    <div class="admin-link-pack">
                                      {project.referenciasUrls.length ? project.referenciasUrls.map((url) => <a href={url} target="_blank" rel="noreferrer">◱</a>) : <span>—</span>}
                                    </div>
                                  </div>
                                </div>
                              </section>
                            ))
                          }
                        </div>
                      </div>
                    </dialog>
                  </div>
                ))
              ) : (
                <article class="admin-empty-state" data-admin-empty-state>
                  <span aria-hidden="true">◎</span>
                  <p>{currentView === "read" ? "Sin contestadas." : "Sin pendientes."}</p>
                </article>
              )
            }
            </section>
          </section>
        ) : (
          <section class="admin-empty-state admin-empty-state--login">
            <span aria-hidden="true">◌</span>
            <p>Acceso cerrado.</p>
          </section>
        )
      }
    </section>

    <dialog class="admin-modal" id="login-modal" data-open-default={!sessionUser ? "true" : "false"}>
      <div class="admin-modal__surface">
        <div class="admin-modal__head">
          <div>
            <p class="eyebrow">Acceso</p>
            <h2>Entrar</h2>
          </div>
          <button class="admin-icon-button admin-icon-button--soft" type="button" data-modal-close title="Cerrar" aria-label="Cerrar">
            <span class="admin-icon-glyph" aria-hidden="true">✕</span>
          </button>
        </div>

        <form class="admin-form admin-form--minimal" method="POST" action="/api/admin/login">
          <label>
            <span>◯</span>
            <input type="text" name="username" value="RoverSmartArt" autocomplete="username" required />
          </label>
          <label>
            <span>◌</span>
            <input type="password" name="password" value="RoverSmartArt" autocomplete="current-password" required />
          </label>
          <button type="submit">→</button>
        </form>
      </div>
    </dialog>

    <dialog class="admin-modal" id="credentials-modal">
      <div class="admin-modal__surface">
        <div class="admin-modal__head">
          <div>
            <p class="eyebrow">Acceso</p>
            <h2>Cambiar</h2>
          </div>
          <button class="admin-icon-button admin-icon-button--soft" type="button" data-modal-close title="Cerrar" aria-label="Cerrar">
            <span class="admin-icon-glyph" aria-hidden="true">✕</span>
          </button>
        </div>

        <form class="admin-form admin-form--minimal" method="POST" action="/api/admin/update-credentials">
          <label>
            <span>◯</span>
            <input type="text" name="username" value={state?.credentials.username || "RoverSmartArt"} minlength="4" required />
          </label>
          <label>
            <span>◌</span>
            <input type="password" name="password" minlength="8" placeholder="nuevo password" required />
          </label>
          <button type="submit">↺</button>
        </form>
      </div>
    </dialog>
  </main>

  <script>
    const modalTriggers = Array.from(document.querySelectorAll("[data-modal-trigger]"));
    const closeButtons = Array.from(document.querySelectorAll("[data-modal-close]"));
    const defaultModal = document.querySelector('[data-open-default="true"]');
    const adminForms = Array.from(document.querySelectorAll('form[action^="/api/admin/"]'));
    const quoteStrip = document.querySelector(".admin-quote-strip");
    const currentView = new URLSearchParams(window.location.search).get("view") === "read" ? "read" : "pending";
    const emptyStateMessage = currentView === "read" ? "Sin contestadas." : "Sin pendientes.";

    const openModal = (id) => {
      const modal = document.getElementById(id);
      if (modal instanceof HTMLDialogElement && !modal.open) {
        modal.showModal();
      }
    };

    const getCountNode = (selector, status) => document.querySelector(`${selector}[data-${selector.includes("summary") ? "summary" : "tab"}-stat="${status}"] [data-${selector.includes("summary") ? "summary" : "tab"}-count]`);

    const readCount = (node) => {
      const value = Number(node?.textContent || "0");
      return Number.isFinite(value) ? value : 0;
    };

    const setCount = (selector, status, value) => {
      const node = getCountNode(selector, status);
      if (node instanceof HTMLElement) {
        node.textContent = String(Math.max(0, value));
      }
    };

    const bumpStatusCount = (status, delta) => {
      setCount("[data-summary-stat]", status, readCount(getCountNode("[data-summary-stat]", status)) + delta);
      setCount("[data-tab-stat]", status, readCount(getCountNode("[data-tab-stat]", status)) + delta);
    };

    const ensureEmptyState = () => {
      if (!(quoteStrip instanceof HTMLElement)) return;
      const hasEntries = quoteStrip.querySelector("[data-quote-entry]");
      const existingEmptyState = quoteStrip.querySelector("[data-admin-empty-state]");

      if (hasEntries) {
        existingEmptyState?.remove();
        return;
      }

      if (existingEmptyState) return;

      const emptyState = document.createElement("article");
      emptyState.className = "admin-empty-state";
      emptyState.setAttribute("data-admin-empty-state", "");
      emptyState.innerHTML = `<span aria-hidden="true">◎</span><p>${emptyStateMessage}</p>`;
      quoteStrip.appendChild(emptyState);
    };

    const removeVisibleQuoteEntry = (form) => {
      const entry = form.closest("[data-quote-entry]");
      const modal = form.closest("dialog");
      const fromStatus = form.querySelector('input[name="status"]')?.value === "read" ? "pending" : "read";
      const toStatus = form.querySelector('input[name="status"]')?.value;

      if (!(entry instanceof HTMLElement) || (toStatus !== "pending" && toStatus !== "read")) return;

      bumpStatusCount(fromStatus, -1);
      bumpStatusCount(toStatus, 1);
      modal?.close();
      entry.remove();
      ensureEmptyState();
    };

    modalTriggers.forEach((trigger) => {
      trigger.addEventListener("click", () => {
        openModal(trigger.getAttribute("data-modal-trigger") || "");
      });
    });

    closeButtons.forEach((button) => {
      button.addEventListener("click", () => {
        button.closest("dialog")?.close();
      });
    });

    document.querySelectorAll("dialog").forEach((modal) => {
      modal.addEventListener("click", (event) => {
        if (event.target === modal) {
          modal.close();
        }
      });
    });

    adminForms.forEach((form) => {
      form.addEventListener("submit", async (event) => {
        event.preventDefault();

        const submitter = event.submitter instanceof HTMLButtonElement ? event.submitter : null;
        const controls = Array.from(form.querySelectorAll("button, input"));
        const formData = new FormData(form);

        controls.forEach((control) => {
          control.disabled = true;
        });

        try {
          const response = await fetch(form.action, {
            method: form.method || "POST",
            body: formData,
            credentials: "same-origin",
            headers: {
              "x-requested-with": "fetch",
              Accept: "application/json"
            }
          });

          const result = await response.json().catch(() => null);

          if (result?.redirectTo) {
            if (form.action.endsWith("/update-quote-status")) {
              removeVisibleQuoteEntry(form);
              return;
            }
            const targetUrl = new URL(result.redirectTo, window.location.origin);
            targetUrl.searchParams.set("_ts", Date.now().toString());
            window.location.replace(targetUrl.toString());
            return;
          }

          if (!response.ok) {
            throw new Error(`Request failed with status ${response.status}`);
          }

          const fallbackUrl = new URL(window.location.href);
          fallbackUrl.searchParams.set("_ts", Date.now().toString());
          window.location.replace(fallbackUrl.toString());
        } catch (error) {
          console.error("Admin form submit failed:", error);
          controls.forEach((control) => {
            control.disabled = false;
          });

          if (submitter) {
            submitter.focus();
          }
        }
      });
    });

    if (defaultModal instanceof HTMLDialogElement) {
      defaultModal.showModal();
    }
  </script>
</BaseLayout>
