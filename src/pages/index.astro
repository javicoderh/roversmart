---
import BaseLayout from "../layouts/BaseLayout.astro";
import SmartGallery from "../components/SmartGallery.vue";
import "../styles/global.css";
import fox2dImage from "../assets/fox2d.png";
import foxImage from "../assets/fox.png";
import foxMidImage from "../assets/foxMid.png";

const formspreeEndpoint = import.meta.env.PUBLIC_FORMSPREE_ENDPOINT ?? "";
const referencesLimit = 2;
const maxProjects = 3;
const maxImageSizeMb = 5;
const maxImageWidth = 2560;
const maxImageHeight = 2560;

const roverMenuItems = [
  { label: "GRAFFITI MURAL", href: "https://www.roversmart.com/pintura" },
  { label: "PRINTS", href: "https://www.roversmart.com/prints" },
  { label: "GRÁFICAS", href: "https://www.roversmart.com/diseo-grfico" },
  { label: "VIDEOS", href: "https://www.roversmart.com/videos" },
  { label: "CLIENTES", href: "https://www.roversmart.com/clientes" },
  { label: "ENCARGOS/CONTACTO", href: "https://www.roversmart.com/contact", active: true }
];

const quoteSteps = [
  { index: "01", label: "Proyectos", title: "Proyectos", caption: "Puedes cotizar varios muros en una sola solicitud" },
  { index: "02", label: "Datos / contacto", title: "Datos / contacto", caption: "Datos de contacto." },
  { index: "03", label: "Proceso", title: "Desglose del proceso", caption: "" }
];
---

<BaseLayout
  title="Cotiza tu mural"
  description="Cotizador visual para proyectos de muralismo, branding y arte mural."
>
  <SmartGallery client:load />
  <header class="site-header-shell">
    <div class="site-header page-shell page-shell--header">
      <button class="mobile-menu-toggle" type="button" aria-expanded="false" aria-controls="mobile-nav" data-mobile-menu-toggle>
        <svg viewBox="0 0 24 24" aria-hidden="true">
          <path d="M4 7.5h16M4 12h16M4 16.5h16" />
        </svg>
        <span class="sr-only">Abrir menú</span>
      </button>
      <a class="site-logo" href="https://www.roversmart.com" aria-label="Ir a roversmart.com">
        <img
          class="site-logo-image site-logo-desktop"
          src="https://dglb26w8rx2ld.cloudfront.net/000_clients/160215/file/1602159E5Mk1bl.png"
          alt="Rover Smart"
          loading="eager"
        />
        <img
          class="site-logo-image site-logo-mobile"
          src="https://dglb26w8rx2ld.cloudfront.net/000_clients/160215/file/1602159E5Mk1bl.png"
          alt=""
          loading="eager"
          aria-hidden="true"
        />
      </a>
      <nav class="site-nav" aria-label="Secciones principales de Rover Smart">
        {
          roverMenuItems.map((item) => (
            <a
              href={item.href}
              class:list={[item.active && "is-active"]}
              target="_self"
              rel="noreferrer"
            >
              {item.label}
            </a>
          ))
        }
      </nav>
      <nav class="mobile-nav" id="mobile-nav" aria-label="Secciones principales de Rover Smart en móvil" data-mobile-nav hidden>
        {
          roverMenuItems.map((item) => (
            <a
              href={item.href}
              class:list={[item.active && "is-active"]}
              target="_self"
              rel="noreferrer"
            >
              {item.label}
            </a>
          ))
        }
      </nav>
    </div>
  </header>

  <main class="page-shell mural-page">
    <section class="hero-panel">
      <div class="hero-panel__copy">
        <p class="eyebrow">Cotizador de murales</p>
        <h1>Cotiza tu mural</h1>
        <p class="hero-note">Solicitud y proceso de cotización.</p>
        <div class="hero-tags" aria-label="Características del flujo">
          <span>Respuesta 3-5 días</span>
          <span>Bocetos aparte</span>
        </div>
      </div>
      <aside class="hero-panel__aside" aria-label="Resumen del flujo">
        <p class="card-label">Ruta</p>
        <ol class="mini-route">
          {
            quoteSteps.map((step) => (
              <li>
                <strong>{step.index}</strong>
                <span>{step.label}</span>
              </li>
            ))
          }
        </ol>
        <a class="hero-link" href="#formulario" data-start-flow>Empezar</a>
      </aside>
    </section>

    <section class="form-shell" id="formulario" data-form-shell hidden aria-hidden="true" tabindex="-1">
      <div class="steps-progress" aria-label="Progreso del formulario">
        <div class="steps-progress__track" aria-hidden="true"></div>
        {
          quoteSteps.map((step, index) => (
            <button
              class:list={["step-chip", index === 0 && "is-active"]}
              type="button"
              data-step-chip
              data-step-target={index}
              aria-current={index === 0 ? "step" : "false"}
            >
              <span class="step-chip__circle">{step.index}</span>
              <span class="step-chip__text">
                <strong>{step.label}</strong>
              </span>
            </button>
          ))
        }
      </div>

      <form
        class="quote-form"
        data-quote-form
        data-formspree-endpoint={formspreeEndpoint}
      >
        <div class="form-stage">
          <div class="form-stage__main">
            <fieldset class="quote-step is-active" data-step={0}>
              <legend class="sr-only">Proyectos</legend>
              <div class="section-card-head">
                <p class="section-index">01</p>
                <div>
                  <p class="section-tag">Proyectos</p>
                  <h2>Muros a cotizar</h2>
                  <p>Puedes agregar varios proyectos dentro de una misma solicitud.</p>
                </div>
              </div>

              <div class="projects-meta">
                <p class="projects-counter" data-projects-counter>1 / {maxProjects} proyectos</p>
              </div>

              <div class="projects-stack" data-projects-list>
                <article class="project-card" data-project-card data-project-index="0">
                  <div class="project-card__head">
                    <div>
                      <p class="card-label">Proyecto</p>
                      <h3 data-project-title>Proyecto 1</h3>
                    </div>
                    <button type="button" class="ghost-button project-remove-button" data-remove-project hidden>Quitar</button>
                  </div>

                  <div class="field-grid">
                    <label>
                      Alto [mts]
                      <input type="number" name="project_alto_0" placeholder="2.8 mts" min="0" step="0.1" data-project-field="alto" />
                    </label>
                    <label>
                      Ancho [mts]
                      <input type="number" name="project_ancho_0" placeholder="6.5 mts" min="0" step="0.1" data-project-field="ancho" />
                    </label>
                    <label class="full">
                      Fotografías muro/soporte [máx. 3]
                      <span class="file-upload-control">
                        <span class="file-upload-trigger">Adjuntar fotografías</span>
                        <input class="file-upload-input" type="file" name="project_foto_frontal_0" accept="image/*" multiple data-project-field="foto_frontal" data-max-files="3" />
                      </span>
                      <small class="field-help">Hasta 3 imágenes de {maxImageSizeMb} MB cada una.</small>
                    </label>
                    <label>
                      Ubicación
                      <select name="project_ubicacion_0" data-project-field="ubicacion">
                        <option value="">Seleccionar</option>
                        <option>Santiago</option>
                        <option>Valparaíso / Viña del Mar</option>
                        <option>Región de Coquimbo</option>
                        <option>Región de O'Higgins</option>
                        <option>Región del Maule</option>
                        <option>Región del Biobío</option>
                        <option>Región de La Araucanía</option>
                        <option>Región de Los Lagos</option>
                        <option>Otra región de Chile</option>
                        <option>Internacional</option>
                      </select>
                    </label>
                    <label>
                      Estado muro/ soporte
                      <select name="project_estado_0" data-project-field="estado">
                        <option value="">Seleccionar</option>
                        <option>Listo para pintar</option>
                        <option>Requiere mantención</option>
                      </select>
                    </label>
                    <div class="availability-grid full">
                      <label class="circle-option">
                        <input type="checkbox" name="project_bodega_disponible_0" value="Sí" data-project-field="bodega_disponible" />
                        <span class="circle-option__control" aria-hidden="true"></span>
                        <span>¿bodegas disponibles?</span>
                      </label>
                      <label class="circle-option">
                        <input type="checkbox" name="project_estacionamiento_disponible_0" value="Sí" data-project-field="estacionamiento_disponible" />
                        <span class="circle-option__control" aria-hidden="true"></span>
                        <span>¿estacionamiento disponible?</span>
                      </label>
                    </div>
                    <label class="full">
                      Notas adicionales
                      <textarea name="project_descripcion_muro_0" rows="4" placeholder="Detalles extra a considerar; flujo masivo de gente, vehículos transitando cerca, obstáculos de acceso para materiales, etc." data-project-field="descripcion_muro"></textarea>
                    </label>
                    <label class="full">
                      Nivel de complejidad [puedes cotizar más de un nivel]
                      <div class="mural-type-grid">
                        <label class="mural-type-option">
                          <img class="mural-type-option__image" src={fox2dImage.src} alt="" aria-hidden="true" />
                          <span class="mural-type-option__choice">
                            <input type="checkbox" name="project_tipo_mural_0" value="Minimal" data-project-field="tipo_mural" />
                            <span class="circle-option__control" aria-hidden="true"></span>
                          </span>
                          <span class="mural-type-option__label">Minimal</span>
                        </label>
                        <label class="mural-type-option">
                          <img class="mural-type-option__image" src={foxMidImage.src} alt="" aria-hidden="true" />
                          <span class="mural-type-option__choice">
                            <input type="checkbox" name="project_tipo_mural_0" value="Intermedio" data-project-field="tipo_mural" />
                            <span class="circle-option__control" aria-hidden="true"></span>
                          </span>
                          <span class="mural-type-option__label">Intermedio</span>
                        </label>
                        <label class="mural-type-option">
                          <img class="mural-type-option__image" src={foxImage.src} alt="" aria-hidden="true" />
                          <span class="mural-type-option__choice">
                            <input type="checkbox" name="project_tipo_mural_0" value="Detallado" data-project-field="tipo_mural" />
                            <span class="circle-option__control" aria-hidden="true"></span>
                          </span>
                          <span class="mural-type-option__label">Detallado</span>
                        </label>
                      </div>
                    </label>
                    <label>
                      Contexto del mural
                      <select name="project_uso_0" data-project-field="uso">
                        <option value="">Seleccionar</option>
                        <option>Decorativo personal</option>
                        <option>Negocio / marketing</option>
                        <option>Evento</option>
                        <option>Espacio público</option>
                      </select>
                    </label>
                    <label class="full">
                      Concepto creativo
                      <textarea name="project_idea_0" rows="5" placeholder="Desarrolla la idea de tu mural..." data-project-field="idea"></textarea>
                    </label>
                    <label class="full">
                      Referencias (opcional)
                      <input type="file" name="project_referencias_0" multiple accept="image/*" data-project-field="referencias" data-references-limit={referencesLimit} />
                      <small class="field-help">
                        Hasta {referencesLimit} imágenes.
                        <span data-project-references-count>0 seleccionadas</span>
                      </small>
                    </label>
                    <label class="full">
                      Protección
                      <div class="protection-options">
                        <label class="circle-option">
                          <input type="checkbox" name="project_proteccion_0" value="Sellante" data-project-field="proteccion" />
                          <span class="circle-option__control" aria-hidden="true"></span>
                          <span>Sellante</span>
                        </label>
                      </div>
                    </label>
                  </div>
                </article>
              </div>

              <template data-project-template>
                <article class="project-card" data-project-card>
                  <div class="project-card__head">
                    <div>
                      <p class="card-label">Proyecto</p>
                      <h3 data-project-title></h3>
                    </div>
                    <button type="button" class="ghost-button project-remove-button" data-remove-project>Quitar</button>
                  </div>

                  <div class="field-grid">
                    <label>
                      Alto [mts]
                      <input type="number" min="0" step="0.1" placeholder="2.8 mts" data-project-field="alto" />
                    </label>
                    <label>
                      Ancho [mts]
                      <input type="number" min="0" step="0.1" placeholder="6.5 mts" data-project-field="ancho" />
                    </label>
                    <label class="full">
                      Fotografías muro/soporte [máx. 3]
                      <span class="file-upload-control">
                        <span class="file-upload-trigger">Adjuntar fotografías</span>
                        <input class="file-upload-input" type="file" accept="image/*" multiple data-project-field="foto_frontal" data-max-files="3" />
                      </span>
                      <small class="field-help">Hasta 3 imágenes de {maxImageSizeMb} MB cada una.</small>
                    </label>
                    <label>
                      Ubicación
                      <select data-project-field="ubicacion">
                        <option value="">Seleccionar</option>
                        <option>Santiago</option>
                        <option>Valparaíso / Viña del Mar</option>
                        <option>Región de Coquimbo</option>
                        <option>Región de O'Higgins</option>
                        <option>Región del Maule</option>
                        <option>Región del Biobío</option>
                        <option>Región de La Araucanía</option>
                        <option>Región de Los Lagos</option>
                        <option>Otra región de Chile</option>
                        <option>Internacional</option>
                      </select>
                    </label>
                    <label>
                      Estado muro/ soporte
                      <select data-project-field="estado">
                        <option value="">Seleccionar</option>
                        <option>Listo para pintar</option>
                        <option>Requiere mantención</option>
                      </select>
                    </label>
                    <div class="availability-grid full">
                      <label class="circle-option">
                        <input type="checkbox" value="Sí" data-project-field="bodega_disponible" />
                        <span class="circle-option__control" aria-hidden="true"></span>
                        <span>¿bodegas disponibles?</span>
                      </label>
                      <label class="circle-option">
                        <input type="checkbox" value="Sí" data-project-field="estacionamiento_disponible" />
                        <span class="circle-option__control" aria-hidden="true"></span>
                        <span>¿estacionamiento disponible?</span>
                      </label>
                    </div>
                    <label class="full">
                      Notas adicionales
                      <textarea rows="4" placeholder="Detalles extra a considerar; flujo masivo de gente, vehículos transitando cerca, obstáculos de acceso para materiales, etc." data-project-field="descripcion_muro"></textarea>
                    </label>
                    <label class="full">
                      Nivel de complejidad [puedes cotizar más de un nivel]
                      <div class="mural-type-grid">
                        <label class="mural-type-option">
                          <img class="mural-type-option__image" src={fox2dImage.src} alt="" aria-hidden="true" />
                          <span class="mural-type-option__choice">
                            <input type="checkbox" value="Minimal" data-project-field="tipo_mural" />
                            <span class="circle-option__control" aria-hidden="true"></span>
                          </span>
                          <span class="mural-type-option__label">Minimal</span>
                        </label>
                        <label class="mural-type-option">
                          <img class="mural-type-option__image" src={foxMidImage.src} alt="" aria-hidden="true" />
                          <span class="mural-type-option__choice">
                            <input type="checkbox" value="Intermedio" data-project-field="tipo_mural" />
                            <span class="circle-option__control" aria-hidden="true"></span>
                          </span>
                          <span class="mural-type-option__label">Intermedio</span>
                        </label>
                        <label class="mural-type-option">
                          <img class="mural-type-option__image" src={foxImage.src} alt="" aria-hidden="true" />
                          <span class="mural-type-option__choice">
                            <input type="checkbox" value="Detallado" data-project-field="tipo_mural" />
                            <span class="circle-option__control" aria-hidden="true"></span>
                          </span>
                          <span class="mural-type-option__label">Detallado</span>
                        </label>
                      </div>
                    </label>
                    <label>
                      Contexto del mural
                      <select data-project-field="uso">
                        <option value="">Seleccionar</option>
                        <option>Decorativo personal</option>
                        <option>Negocio / marketing</option>
                        <option>Evento</option>
                        <option>Espacio público</option>
                      </select>
                    </label>
                    <label class="full">
                      Concepto creativo
                      <textarea rows="5" placeholder="Desarrolla la idea de tu mural..." data-project-field="idea"></textarea>
                    </label>
                    <label class="full">
                      Referencias (opcional)
                      <input type="file" multiple accept="image/*" data-project-field="referencias" data-references-limit={referencesLimit} />
                      <small class="field-help">
                        Hasta {referencesLimit} imágenes.
                        <span data-project-references-count>0 seleccionadas</span>
                      </small>
                    </label>
                    <label class="full">
                      Protección
                      <div class="protection-options">
                        <label class="circle-option">
                          <input type="checkbox" value="Sellante" data-project-field="proteccion" />
                          <span class="circle-option__control" aria-hidden="true"></span>
                          <span>Sellante</span>
                        </label>
                      </div>
                    </label>
                  </div>
                </article>
              </template>

              <div class="step-actions">
                <button type="button" class="ghost-button" data-add-project data-max-projects={maxProjects}>+ Agregar proyecto</button>
                <button type="button" data-step-next>Siguiente</button>
              </div>
            </fieldset>

            <fieldset class="quote-step" data-step={1} hidden>
              <legend class="sr-only">Datos / contacto</legend>
              <div class="section-card-head">
                <p class="section-index">02</p>
                <div>
                  <p class="section-tag">Datos / contacto</p>
                  <h2>Datos / contacto</h2>
                  <p>Datos de contacto.</p>
                </div>
              </div>

              <article class="project-card">
                <div class="field-grid field-grid--contact">
                  <label class="contact-name">
                    Nombre
                    <input type="text" name="nombre" placeholder="tu nombre / nombre empresa / marca" data-contact-field="nombre" />
                  </label>
                  <label class="contact-email">
                    E-mail
                    <input type="email" name="email" placeholder="nombre@correo.com" required data-contact-field="email" />
                  </label>
                  <label class="contact-phone">
                    Teléfono
                    <input type="tel" name="telefono" placeholder="+56 9 ..." data-contact-field="telefono" />
                  </label>
                  <label class="contact-description">
                    Descripción del cliente
                    <textarea name="tipo_cliente" rows="6" placeholder="describe a la persona, institución o marca que solicita el mural." data-contact-field="tipo_cliente"></textarea>
                  </label>
                </div>
              </article>

              <div class="step-actions">
                <button type="button" class="ghost-button" data-step-prev>Atrás</button>
                <button type="button" data-step-next>Siguiente</button>
              </div>
            </fieldset>

            <fieldset class="quote-step" data-step={2} hidden>
              <legend class="sr-only">Proceso</legend>
              <div class="section-card-head">
                <p class="section-index">03</p>
                <div>
                  <p class="section-tag">Proceso</p>
                  <h2>Desglose del proceso</h2>
                </div>
              </div>

              <article class="project-card">
                <div class="process-overview">
                  <ol>
                  <li>Cliente completa el formulario de cotización.</li>
                  <li>Cliente recibe la cotización en 3-5 días hábiles aprox. desde la solicitud.</li>
                  <li>De ser aprobada la cotización, el cliente debe abonar el 50% del ítem diseño.</li>
                  <li>Reunión cliente-artista.</li>
                  <li>Comienza el proceso de feedback para el diseño.</li>
                  <li>Aprobado el diseño, cliente debe abonar el 50% restante de este + ítem materiales y logística.</li>
                  <li>Proceso de compra de materiales / mezcla de colores.</li>
                  <li>Ejecución del mural.</li>
                  <li>Entrega del mural.</li>
                  <li>Pago final [máximo 5 días hábiles desde la entrega].</li>
                  </ol>
                </div>
              </article>

              <div class="step-actions">
                <button type="button" class="ghost-button" data-step-prev>Atrás</button>
                <button type="submit" data-submit-button>Enviar</button>
              </div>
            </fieldset>
          </div>
          <section class="submission-state" data-submission-state hidden aria-live="polite" aria-hidden="true">
            <div class="submission-state__spinner" data-submission-spinner aria-hidden="true"></div>
            <p class="submission-state__message" data-submission-message>Preparando envío...</p>
          </section>
        </div>
      </form>

      <div class="validation-modal" data-validation-modal hidden aria-hidden="true">
        <div class="validation-modal__backdrop" data-validation-close></div>
        <div
          class="validation-modal__dialog"
          role="dialog"
          aria-modal="true"
          aria-labelledby="validation-modal-title"
          aria-describedby="validation-modal-description"
          tabindex="-1"
          data-validation-dialog
        >
          <button class="validation-modal__close" type="button" aria-label="Cerrar modal de validación" data-validation-close>
            Cerrar
          </button>
          <p class="validation-modal__eyebrow">Revisión pendiente</p>
          <h3 id="validation-modal-title">Hay campos que corregir</h3>
          <p id="validation-modal-description">Revisa los errores detectados y vuelve al paso indicado sin perder el progreso.</p>
          <ul class="validation-modal__list" data-validation-errors></ul>
        </div>
      </div>
    </section>
  </main>

  <script>
    const form = document.querySelector("[data-quote-form]");
    const stepsProgress = document.querySelector(".steps-progress");
    const formStage = document.querySelector(".form-stage");
    const stepPanels = Array.from(document.querySelectorAll("[data-step]"));
    const stepChips = Array.from(document.querySelectorAll("[data-step-chip]"));
    const nextButtons = Array.from(document.querySelectorAll("[data-step-next]"));
    const prevButtons = Array.from(document.querySelectorAll("[data-step-prev]"));
    const startFlowButton = document.querySelector("[data-start-flow]");
    const formShell = document.querySelector("[data-form-shell]");
    const submitStatus = document.querySelector("[data-submit-status]");
    const submitButton = document.querySelector("[data-submit-button]");
    const submissionState = document.querySelector("[data-submission-state]");
    const submissionMessage = document.querySelector("[data-submission-message]");
    const submissionSpinner = document.querySelector("[data-submission-spinner]");
    const projectsList = document.querySelector("[data-projects-list]");
    const projectTemplate = document.querySelector("[data-project-template]");
    const addProjectButton = document.querySelector("[data-add-project]");
    const projectsCounter = document.querySelector("[data-projects-counter]");
    const mobileMenuToggle = document.querySelector("[data-mobile-menu-toggle]");
    const mobileNav = document.querySelector("[data-mobile-nav]");
    const validationModal = document.querySelector("[data-validation-modal]");
    const validationDialog = document.querySelector("[data-validation-dialog]");
    const validationErrorsList = document.querySelector("[data-validation-errors]");
    const validationCloseButtons = Array.from(document.querySelectorAll("[data-validation-close]"));
    const contactFields = {
      nombre: form?.querySelector('[data-contact-field="nombre"]'),
      email: form?.querySelector('[data-contact-field="email"]'),
      telefono: form?.querySelector('[data-contact-field="telefono"]'),
      tipo_cliente: form?.querySelector('[data-contact-field="tipo_cliente"]')
    };
    const regexRules = {
      measurement: /^(?:0\.[1-9]\d?|[1-9]\d{0,2}(?:[.,]\d{1,2})?)$/,
      idea: /^(?=.{20,800}$)(?=.*[A-Za-zÀ-ÿ])[A-Za-zÀ-ÿ0-9¿?¡!.,:;'"%/()#&+\-\s\n]+$/,
      name: /^(?=.{3,100}$)(?=.*[A-Za-zÀ-ÿ])[A-Za-zÀ-ÿ0-9&.' -]+$/,
      email: /^[^\s@]+@[^\s@]+\.[^\s@]{2,}$/,
      phone: /^\+?[0-9][0-9\s()-]{7,19}$/,
      clientDescription: /^(?=.{12,400}$)(?=.*[A-Za-zÀ-ÿ])[A-Za-zÀ-ÿ0-9¿?¡!.,:;'"%/()#&+\-\s\n]+$/
    };
    const maxImageSizeBytes = 5 * 1024 * 1024;
    const maxImageWidth = 2560;
    const maxImageHeight = 2560;
    const projectFieldLabels = {
      alto: "Alto",
      ancho: "Ancho",
      foto_frontal: "Fotografías del muro",
      ubicacion: "Ubicación",
      estado: "Estado del muro",
      tipo_mural: "Nivel de complejidad",
      uso: "Contexto del mural",
      idea: "Concepto creativo"
    };
    const contactFieldLabels = {
      nombre: "Nombre",
      email: "E-mail",
      telefono: "Teléfono",
      tipo_cliente: "Descripción del cliente"
    };
    let currentStep = 0;
    let flowStarted = false;
    let lastFocusedElement = null;

    const processLines = [
      "1. Cliente completa el formulario de cotización.",
      "2. Cliente recibe la cotización en 3-5 días hábiles aprox. desde la solicitud.",
      "3. De ser aprobada la cotización, el cliente debe abonar el 50% del ítem diseño.",
      "4. Reunión cliente-artista.",
      "5. Comienza el proceso de feedback para el diseño.",
      "6. Aprobado el diseño, cliente debe abonar el 50% restante de este + ítem materiales y logística.",
      "7. Proceso de compra de materiales / mezcla de colores.",
      "8. Ejecución del mural.",
      "9. Entrega del mural.",
      "10. Pago final [máximo 5 días hábiles desde la entrega]."
    ];
    const maxProjects = Number(addProjectButton?.getAttribute("data-max-projects") || "5");

    const normalizeText = (value) => value.trim().replace(/\s+/g, " ");
    const toList = (value) => (Array.isArray(value) ? value : value ? [value] : []);
    const clearStatusToDefault = () => {};
    const setSubmissionState = (message, { visible = true, success = false } = {}) => {
      if (!(submissionState instanceof HTMLElement)) return;
      submissionState.hidden = !visible;
      submissionState.setAttribute("aria-hidden", visible ? "false" : "true");
      submissionState.classList.toggle("is-success", success);
      if (stepsProgress instanceof HTMLElement) {
        stepsProgress.hidden = visible;
      }
      if (formStage instanceof HTMLElement) {
        formStage.hidden = visible;
      }
      if (submissionMessage instanceof HTMLElement) submissionMessage.textContent = message;
      if (submissionSpinner instanceof HTMLElement) submissionSpinner.hidden = success;
    };

    const getProjects = () => Array.from(projectsList?.querySelectorAll("[data-project-card]") || []);

    const setStep = (targetStep) => {
      currentStep = Math.min(Math.max(targetStep, 0), stepPanels.length - 1);
      stepPanels.forEach((panel, index) => {
        const isActive = index === currentStep;
        panel.hidden = !isActive;
        panel.classList.toggle("is-active", isActive);
      });
      stepChips.forEach((chip, index) => {
        chip.classList.toggle("is-active", index === currentStep);
        chip.classList.toggle("is-done", index < currentStep);
        chip.setAttribute("aria-current", index === currentStep ? "step" : "false");
      });
    };

    const revealForm = () => {
      if (!(formShell instanceof HTMLElement) || flowStarted) return;
      flowStarted = true;
      formShell.hidden = false;
      formShell.setAttribute("aria-hidden", "false");
      requestAnimationFrame(() => {
        formShell.classList.add("is-visible");
        formShell.focus();
        formShell.scrollIntoView({ behavior: "smooth", block: "start" });
      });
    };

    const closeValidationModal = () => {
      if (!(validationModal instanceof HTMLElement)) return;
      validationModal.hidden = true;
      validationModal.setAttribute("aria-hidden", "true");
      document.body.classList.remove("modal-open");
      if (lastFocusedElement instanceof HTMLElement) lastFocusedElement.focus();
    };

    const openValidationModal = (errors) => {
      if (!(validationModal instanceof HTMLElement) || !(validationDialog instanceof HTMLElement) || !(validationErrorsList instanceof HTMLElement)) {
        return;
      }
      lastFocusedElement = document.activeElement instanceof HTMLElement ? document.activeElement : null;
      validationErrorsList.innerHTML = "";
      errors.forEach((error) => {
        const item = document.createElement("li");
        const button = document.createElement("button");
        button.type = "button";
        button.className = "validation-modal__error-link";
        button.innerHTML = `<strong>${error.label}</strong><span>${error.message}</span>`;
        button.addEventListener("click", () => {
          closeValidationModal();
          setStep(error.stepIndex);
          requestAnimationFrame(() => {
            error.element?.focus();
            error.element?.scrollIntoView({ behavior: "smooth", block: "center" });
          });
        });
        item.appendChild(button);
        validationErrorsList.appendChild(item);
      });
      validationModal.hidden = false;
      validationModal.setAttribute("aria-hidden", "false");
      document.body.classList.add("modal-open");
      requestAnimationFrame(() => validationDialog.focus());
    };

    const toggleInvalidState = (element, isInvalid) => {
      if (!(element instanceof HTMLElement)) return;
      element.classList.toggle("is-invalid", isInvalid);
      element.setAttribute("aria-invalid", isInvalid ? "true" : "false");
      element.closest("label, .mural-type-grid")?.classList.toggle("is-invalid", isInvalid);
    };

    const validateImageFiles = (input, maxFiles) => {
      const files = Array.from(input.files || []);
      if (!files.length) return "Adjunta al menos una fotografía del muro o soporte.";
      if (maxFiles > 0 && files.length > maxFiles) return `Adjunta un máximo de ${maxFiles} imágenes.`;
      for (const file of files) {
        if (!file.type.startsWith("image/")) return "Solo se permiten archivos de imagen.";
        if (file.size > maxImageSizeBytes * 2) return "Cada imagen debe pesar menos de 10 MB antes de optimizarse.";
      }
      return "";
    };

    const getProjectField = (card, fieldName) => {
      const matches = Array.from(card.querySelectorAll(`[data-project-field="${fieldName}"]`));
      if (fieldName === "tipo_mural" || fieldName === "proteccion") return matches;
      return matches[0] || null;
    };

    const getProjectErrors = (card, projectIndex) => {
      const errors = [];
      const alto = getProjectField(card, "alto");
      const ancho = getProjectField(card, "ancho");
      const foto = getProjectField(card, "foto_frontal");
      const ubicacion = getProjectField(card, "ubicacion");
      const estado = getProjectField(card, "estado");
      const uso = getProjectField(card, "uso");
      const idea = getProjectField(card, "idea");
      const tipos = getProjectField(card, "tipo_mural");

      const checks = [
        ["alto", alto, () => {
          const value = normalizeText(alto?.value || "").replace(",", ".");
          if (!value) return "Completa el alto del muro.";
          if (!regexRules.measurement.test(value)) return "Usa medidas en metros con hasta 2 decimales.";
          return "";
        }],
        ["ancho", ancho, () => {
          const value = normalizeText(ancho?.value || "").replace(",", ".");
          if (!value) return "Completa el ancho del muro.";
          if (!regexRules.measurement.test(value)) return "Usa medidas en metros con hasta 2 decimales.";
          return "";
        }],
        ["foto_frontal", foto, () => validateImageFiles(foto, Number(foto?.dataset.maxFiles || "0"))],
        ["ubicacion", ubicacion, () => (!normalizeText(ubicacion?.value || "") ? "Selecciona la ubicación del proyecto." : "")],
        ["estado", estado, () => (!normalizeText(estado?.value || "") ? "Selecciona el estado del muro." : "")],
        ["uso", uso, () => (!normalizeText(uso?.value || "") ? "Selecciona el contexto del mural." : "")],
        ["idea", idea, () => {
          const value = (idea?.value || "").trim();
          if (!value) return "Describe el concepto creativo del mural.";
          if (!regexRules.idea.test(value)) return "El concepto debe tener al menos 20 caracteres útiles.";
          return "";
        }]
      ];

      checks.forEach(([fieldName, element, getError]) => {
        const message = getError();
        toggleInvalidState(element, Boolean(message));
        if (message) {
          errors.push({
            stepIndex: 0,
            label: `Paso 01 · Proyecto ${projectIndex + 1} · ${projectFieldLabels[fieldName]}`,
            message,
            element
          });
        }
      });

      const anyTipo = Array.isArray(tipos) && tipos.some((input) => input instanceof HTMLInputElement && input.checked);
      tipos.forEach((input) => toggleInvalidState(input, !anyTipo));
      if (!anyTipo) {
        errors.push({
          stepIndex: 0,
          label: `Paso 01 · Proyecto ${projectIndex + 1} · Nivel de complejidad`,
          message: "Selecciona al menos un nivel de complejidad.",
          element: tipos[0]
        });
      }

      return errors;
    };

    const getContactErrors = () => {
      const errors = [];
      const checks = [
        ["nombre", contactFields.nombre, () => {
          const value = normalizeText(contactFields.nombre?.value || "");
          if (!value) return "Indica el nombre de contacto o de la marca.";
          if (!regexRules.name.test(value)) return "El nombre debe tener entre 3 y 100 caracteres válidos.";
          return "";
        }],
        ["email", contactFields.email, () => {
          const value = normalizeText(contactFields.email?.value || "");
          if (!value) return "Indica un correo de contacto.";
          if (!regexRules.email.test(value)) return "El correo no tiene un formato válido.";
          return "";
        }],
        ["telefono", contactFields.telefono, () => {
          const value = normalizeText(contactFields.telefono?.value || "");
          if (!value) return "Indica un teléfono de contacto.";
          if (!regexRules.phone.test(value)) return "El teléfono debe incluir entre 8 y 20 caracteres válidos.";
          return "";
        }],
        ["tipo_cliente", contactFields.tipo_cliente, () => {
          const value = (contactFields.tipo_cliente?.value || "").trim();
          if (!value) return "Describe el tipo de cliente que solicita el mural.";
          if (!regexRules.clientDescription.test(value)) return "La descripción del cliente debe tener al menos 12 caracteres útiles.";
          return "";
        }]
      ];
      checks.forEach(([fieldName, element, getError]) => {
        const message = getError();
        toggleInvalidState(element, Boolean(message));
        if (message) {
          errors.push({
            stepIndex: 1,
            label: `Paso 02 · ${contactFieldLabels[fieldName]}`,
            message,
            element
          });
        }
      });
      return errors;
    };

    const validateStep = (stepIndex) => {
      if (stepIndex === 0) return getProjects().flatMap((card, index) => getProjectErrors(card, index));
      if (stepIndex === 1) return getContactErrors();
      return [];
    };

    const fileToImage = (file) =>
      new Promise((resolve, reject) => {
        const image = new Image();
        const objectUrl = URL.createObjectURL(file);
        image.onload = () => resolve({ image, objectUrl });
        image.onerror = () => {
          URL.revokeObjectURL(objectUrl);
          reject(new Error("No se pudo leer una de las imágenes seleccionadas."));
        };
        image.src = objectUrl;
      });

    const canvasToBlob = (canvas, quality) =>
      new Promise((resolve, reject) => {
        canvas.toBlob((blob) => {
          if (!blob) {
            reject(new Error("No se pudo comprimir una de las imágenes seleccionadas."));
            return;
          }
          resolve(blob);
        }, "image/jpeg", quality);
      });

    const optimizeImageFile = async (file) => {
      const { image, objectUrl } = await fileToImage(file);
      const needsResize = image.width > maxImageWidth || image.height > maxImageHeight;
      const needsCompression = file.size > maxImageSizeBytes;
      if (!needsResize && !needsCompression) {
        URL.revokeObjectURL(objectUrl);
        return file;
      }
      const ratio = Math.min(maxImageWidth / image.width, maxImageHeight / image.height, 1);
      const width = Math.round(image.width * ratio);
      const height = Math.round(image.height * ratio);
      const canvas = document.createElement("canvas");
      const context = canvas.getContext("2d");
      if (!context) {
        URL.revokeObjectURL(objectUrl);
        throw new Error("No se pudo preparar la compresión de imágenes.");
      }
      canvas.width = width;
      canvas.height = height;
      context.drawImage(image, 0, 0, width, height);
      let quality = 0.86;
      let blob = await canvasToBlob(canvas, quality);
      while (blob.size > maxImageSizeBytes && quality > 0.45) {
        quality -= 0.08;
        blob = await canvasToBlob(canvas, quality);
      }
      URL.revokeObjectURL(objectUrl);
      if (blob.size > maxImageSizeBytes) {
        throw new Error("Una imagen sigue siendo demasiado pesada incluso después de comprimirla.");
      }
      return new File([blob], file.name.replace(/\.\w+$/, ".jpg"), { type: "image/jpeg", lastModified: Date.now() });
    };

    const replaceInputFiles = (input, files) => {
      const dataTransfer = new DataTransfer();
      files.forEach((file) => dataTransfer.items.add(file));
      input.files = dataTransfer.files;
    };

    const syncProjectCounts = (card) => {
      const input = getProjectField(card, "referencias");
      const countNode = card.querySelector("[data-project-references-count]");
      if (!(input instanceof HTMLInputElement) || !(countNode instanceof HTMLElement)) return;
      const count = input.files?.length || 0;
      countNode.textContent = `${count} seleccionada${count === 1 ? "" : "s"}`;
    };

    const renameProjectCardFields = (card, index) => {
      card.dataset.projectIndex = String(index);
      const title = card.querySelector("[data-project-title]");
      if (title) title.textContent = `Proyecto ${index + 1}`;
      const singleFields = ["alto", "ancho", "foto_frontal", "ubicacion", "estado", "uso", "idea", "referencias", "descripcion_muro"];
      singleFields.forEach((field) => {
        const input = getProjectField(card, field);
        if (input instanceof HTMLElement) input.setAttribute("name", `project_${field}_${index}`);
      });
      ["bodega_disponible", "estacionamiento_disponible", "tipo_mural", "proteccion"].forEach((field) => {
        const inputs = getProjectField(card, field);
        if (Array.isArray(inputs)) {
          inputs.forEach((input) => input.setAttribute("name", `project_${field}_${index}`));
        } else if (inputs instanceof HTMLElement) {
          inputs.setAttribute("name", `project_${field}_${index}`);
        }
      });
      const removeButton = card.querySelector("[data-remove-project]");
      if (removeButton instanceof HTMLButtonElement) {
        removeButton.hidden = getProjects().length <= 1;
      }
    };

    const refreshProjectsUI = () => {
      const projects = getProjects();
      projects.forEach((card, index) => renameProjectCardFields(card, index));
      if (projectsCounter instanceof HTMLElement) {
        projectsCounter.textContent = `${projects.length} / ${maxProjects} proyectos`;
      }
      if (addProjectButton instanceof HTMLButtonElement) {
        const atLimit = projects.length >= maxProjects;
        addProjectButton.disabled = atLimit;
        addProjectButton.setAttribute("aria-disabled", atLimit ? "true" : "false");
        addProjectButton.textContent = atLimit ? `Máximo ${maxProjects} proyectos` : "+ Agregar proyecto";
      }
    };

    const bindProjectCard = (card) => {
      const referencesInput = getProjectField(card, "referencias");
      const wallInput = getProjectField(card, "foto_frontal");
      [referencesInput, wallInput].forEach((input) => {
        if (!(input instanceof HTMLInputElement)) return;
        input.addEventListener("change", async () => {
          let files = Array.from(input.files || []);
          const limit = Number(input.dataset.referencesLimit || input.dataset.maxFiles || "0");
          if (limit > 0 && files.length > limit) {
            files = files.slice(0, limit);
            replaceInputFiles(input, files);
            if (submitStatus) submitStatus.textContent = `Máximo ${limit} imágenes.`;
          }
          try {
            const optimized = [];
            for (const file of files) optimized.push(await optimizeImageFile(file));
            replaceInputFiles(input, optimized);
            if (submitStatus && optimized.some((file, idx) => file !== files[idx])) {
              submitStatus.textContent = "Se optimizó una o más imágenes.";
            }
          } catch (error) {
            input.value = "";
            if (submitStatus) submitStatus.textContent = error instanceof Error ? error.message : "Una imagen no cumple los requisitos.";
          }
          syncProjectCounts(card);
        });
      });
      const removeButton = card.querySelector("[data-remove-project]");
      if (removeButton instanceof HTMLButtonElement) {
        removeButton.addEventListener("click", () => {
          if (getProjects().length <= 1) return;
          card.remove();
          refreshProjectsUI();
          clearStatusToDefault();
        });
      }
      syncProjectCounts(card);
    };

    const addProjectCard = () => {
      if (getProjects().length >= maxProjects) {
        if (submitStatus) submitStatus.textContent = `Máximo ${maxProjects} proyectos por solicitud.`;
        return;
      }
      if (!(projectsList instanceof HTMLElement) || !(projectTemplate instanceof HTMLTemplateElement)) return;
      const fragment = projectTemplate.content.cloneNode(true);
      const card = fragment.querySelector("[data-project-card]");
      if (!(card instanceof HTMLElement)) return;
      projectsList.appendChild(fragment);
      const insertedCard = getProjects().at(-1);
      if (insertedCard) bindProjectCard(insertedCard);
      refreshProjectsUI();
      clearStatusToDefault();
    };

    const readProject = async (card, index) => {
      const uploadGroup = async (input, folder) => {
        if (!(input instanceof HTMLInputElement)) return [];
        const urls = [];
        for (const file of Array.from(input.files || [])) {
          const uploadData = new FormData();
          uploadData.append("file", file);
          uploadData.append("folder", folder);
          const response = await fetch("/api/upload-image", { method: "POST", body: uploadData });
          const result = await response.json();
          if (!response.ok || !result.url) throw new Error(result.error || "No se pudo subir una imagen.");
          urls.push(result.url);
        }
        return urls;
      };

      const tipoMural = getProjectField(card, "tipo_mural");
      const proteccion = getProjectField(card, "proteccion");
      const fotoInput = getProjectField(card, "foto_frontal");
      const referenciasInput = getProjectField(card, "referencias");

      return {
        id: crypto.randomUUID(),
        title: `Proyecto ${index + 1}`,
        alto: normalizeText(getProjectField(card, "alto")?.value || ""),
        ancho: normalizeText(getProjectField(card, "ancho")?.value || ""),
        ubicacion: normalizeText(getProjectField(card, "ubicacion")?.value || ""),
        estado: normalizeText(getProjectField(card, "estado")?.value || ""),
        bodegaDisponible: Boolean(getProjectField(card, "bodega_disponible")?.checked),
        estacionamientoDisponible: Boolean(getProjectField(card, "estacionamiento_disponible")?.checked),
        descripcionMuro: (getProjectField(card, "descripcion_muro")?.value || "").trim(),
        tiposMural: Array.isArray(tipoMural) ? tipoMural.filter((input) => input.checked).map((input) => input.value) : [],
        uso: normalizeText(getProjectField(card, "uso")?.value || ""),
        idea: (getProjectField(card, "idea")?.value || "").trim(),
        proteccion: Array.isArray(proteccion) ? proteccion.filter((input) => input.checked).map((input) => input.value) : [],
        fotoFrontalUrls: await uploadGroup(fotoInput, `quotes/project-${index + 1}/wall`),
        referenciasUrls: await uploadGroup(referenciasInput, `quotes/project-${index + 1}/references`)
      };
    };

    const buildSubmissionPayload = (contact, projects) => ({
      contacto_nombre: contact.nombre,
      contacto_email: contact.email,
      contacto_whatsapp: contact.telefono,
      contacto_descripcion_cliente: contact.tipo_cliente,
      proyectos_resumen: projects.map((project, index) => [
        `Proyecto ${index + 1}`,
        `Medidas: Alto ${project.alto}m | Ancho ${project.ancho}m`,
        `Ubicación: ${project.ubicacion}`,
        `Estado: ${project.estado}`,
        `Bodega: ${project.bodegaDisponible ? "Sí" : "No"}`,
        `Estacionamiento: ${project.estacionamientoDisponible ? "Sí" : "No"}`,
        `Notas muro: ${project.descripcionMuro || "-"}`,
        `Complejidad: ${project.tiposMural.join(", ") || "-"}`,
        `Contexto: ${project.uso}`,
        `Concepto: ${project.idea}`,
        `Protección: ${project.proteccion.join(", ") || "-"}`,
        `Fotos muro: ${project.fotoFrontalUrls.join("\n") || "Sin adjuntos"}`,
        `Referencias: ${project.referenciasUrls.join("\n") || "Sin adjuntos"}`
      ].join("\n")).join("\n\n--------------------\n\n"),
      desgloce_del_proceso: processLines.join("\n")
    });

    const buildQuoteRecord = (contact, projects) => ({
      id: crypto.randomUUID(),
      createdAt: new Date().toISOString(),
      contact: {
        name: contact.nombre,
        email: contact.email,
        phone: contact.telefono,
        clientDescription: contact.tipo_cliente
      },
      projects,
      process: processLines.map((line) => line.replace(/^\d+\.\s*/, ""))
    });

    stepChips.forEach((chip) => {
      chip.addEventListener("click", () => {
        revealForm();
        setStep(Number(chip.dataset.stepTarget || "0"));
      });
    });

    nextButtons.forEach((button) => {
      button.addEventListener("click", () => {
        revealForm();
        const errors = validateStep(currentStep);
        if (errors.length) {
          if (submitStatus) submitStatus.textContent = errors[0].message;
          openValidationModal(errors);
          return;
        }
        clearStatusToDefault();
        setStep(currentStep + 1);
      });
    });

    prevButtons.forEach((button) => button.addEventListener("click", () => setStep(currentStep - 1)));
    addProjectButton?.addEventListener("click", addProjectCard);

    startFlowButton?.addEventListener("click", (event) => {
      event.preventDefault();
      revealForm();
      setStep(0);
      const firstFocusable = formShell?.querySelector("input, select, textarea, button");
      if (firstFocusable instanceof HTMLElement) setTimeout(() => firstFocusable.focus(), 220);
    });

    validationCloseButtons.forEach((button) => button.addEventListener("click", closeValidationModal));
    document.addEventListener("keydown", (event) => {
      if (event.key === "Escape" && validationModal instanceof HTMLElement && !validationModal.hidden) closeValidationModal();
    });

    mobileMenuToggle?.addEventListener("click", () => {
      if (!(mobileNav instanceof HTMLElement) || !(mobileMenuToggle instanceof HTMLButtonElement)) return;
      const isOpen = mobileMenuToggle.getAttribute("aria-expanded") === "true";
      mobileMenuToggle.setAttribute("aria-expanded", String(!isOpen));
      mobileNav.hidden = isOpen;
      mobileNav.classList.toggle("is-open", !isOpen);
      document.body.classList.toggle("mobile-menu-open", !isOpen);
    });

    mobileNav?.querySelectorAll("a").forEach((link) => {
      link.addEventListener("click", () => {
        if (!(mobileNav instanceof HTMLElement) || !(mobileMenuToggle instanceof HTMLButtonElement)) return;
        mobileMenuToggle.setAttribute("aria-expanded", "false");
        mobileNav.hidden = true;
        mobileNav.classList.remove("is-open");
        document.body.classList.remove("mobile-menu-open");
      });
    });

    form?.addEventListener("submit", async (event) => {
      event.preventDefault();
      if (!(form instanceof HTMLFormElement)) return;
      const endpoint = form.dataset.formspreeEndpoint || "";
      if (!endpoint) {
        if (submitStatus) submitStatus.textContent = "Configura Formspree antes de enviar.";
        return;
      }
      const allErrors = [0, 1].flatMap((stepIndex) => validateStep(stepIndex));
      if (allErrors.length) {
        if (submitStatus) submitStatus.textContent = allErrors[0].message;
        openValidationModal(allErrors);
        setStep(allErrors[0].stepIndex);
        return;
      }
      try {
        if (submitButton instanceof HTMLButtonElement) {
          submitButton.disabled = true;
          submitButton.textContent = "Enviando...";
        }
        setSubmissionState("Subiendo imágenes...");
        const projects = [];
        for (const [index, card] of getProjects().entries()) {
          setSubmissionState(`Subiendo imágenes del proyecto ${index + 1} de ${getProjects().length}...`);
          projects.push(await readProject(card, index));
        }
        const contact = {
          nombre: normalizeText(contactFields.nombre?.value || ""),
          email: normalizeText(contactFields.email?.value || ""),
          telefono: normalizeText(contactFields.telefono?.value || ""),
          tipo_cliente: (contactFields.tipo_cliente?.value || "").trim()
        };
        const payload = buildSubmissionPayload(contact, projects);
        setSubmissionState("Enviando solicitud...");
        const response = await fetch("/api/quotes", {
          method: "POST",
          headers: {
            "Content-Type": "application/json",
            Accept: "application/json"
          },
          body: JSON.stringify({
            formspreePayload: payload,
            quoteRecord: buildQuoteRecord(contact, projects)
          })
        });
        if (!response.ok) {
          const result = await response.json().catch(() => null);
          throw new Error(result?.error || "No se pudo guardar la cotización.");
        }
        form.reset();
        getProjects().slice(1).forEach((card) => card.remove());
        refreshProjectsUI();
        getProjects().forEach((card) => syncProjectCounts(card));
        setStep(0);
        clearStatusToDefault();
        setSubmissionState("Tu cotización ha sido ingresada, recibirás respuesta en 3-5 días hábiles aprox.", { success: true });
      } catch (error) {
        setSubmissionState(error instanceof Error ? error.message : "Ocurrió un problema al enviar la solicitud.", { visible: false });
        if (submitStatus) submitStatus.textContent = error instanceof Error ? error.message : "Ocurrió un problema al enviar la solicitud.";
      } finally {
        if (submitButton instanceof HTMLButtonElement) {
          submitButton.disabled = false;
          submitButton.textContent = "Enviar";
        }
      }
    });

    getProjects().forEach((card) => bindProjectCard(card));
    refreshProjectsUI();
    setStep(0);
  </script>
</BaseLayout>
